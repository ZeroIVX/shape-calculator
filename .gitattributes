# 默认策略：文本文件统一换行
* text=auto eol=crlf

# 源码与脚本为 GBK 编码（Windows 中文环境 + EasyX 窄字符接口）
# 仓库内以 UTF-8 存储（GitHub 正常显示中文），检出到工作区时转回 GBK（保证可直接编译）
*.cpp  text working-tree-encoding=GBK
*.h    text working-tree-encoding=GBK
*.bat  text working-tree-encoding=GBK

# 文档使用 LF
*.md   text eol=lf

# 二进制文件
*.png  binary
*.jpg  binary
*.lib  binary
